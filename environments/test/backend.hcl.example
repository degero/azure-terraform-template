# Copy to backend.hcl (gitignored) and fill in, or pass equivalent
# -backend-config flags in CI. Each environment MUST use a distinct
# storage account/container/key combination or state files will collide.
#
# Do not add access_key, sas_token or client_secret here. Prefer Azure OIDC
# with a user-assigned managed identity.
#
# Usage: terraform init -backend-config="backend.hcl"

# subscription_id    = "" # Only needed if state is in a different subscription
# tenant_id          = "" # Only needed if state is in a different tenant
resource_group_name  = "" # e.g. rg-tfstate-shared
storage_account_name = "" # e.g. sttfstateshared001
container_name       = "tfstate"
key                  = "" # e.g. helloworld/test/terraform.tfstate
